<?xml version="1.0"?>
<ruleset name="Nominal AI Provider for OpenCode">
	<description>WordPress Coding Standards, plus column alignment and chopped long calls.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="tab-width" value="4"/>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>scripts/*</exclude-pattern>
	<exclude-pattern>languages/*</exclude-pattern>
	<!-- PHPStan stubs, not plugin code. -->
	<exclude-pattern>wp-stubs.php</exclude-pattern>

	<!-- Plugin requires PHP 7.4 and WordPress 6.9. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.9"/>

	<rule ref="WordPress">
		<!-- PSR-4 file names (Nominal_AIPO_*.php), not class-nominal-aipo-*.php. -->
		<exclude name="WordPress.Files.FileName"/>

		<!--
			WPCS aligns on tab stops only (PrecisionAlignment).
			This project aligns on the character: assignments, array arrows, PHPDoc.
		-->
		<exclude name="Universal.WhiteSpace.PrecisionAlignment"/>

		<!-- One space after the type blocks a column-aligned @param name. -->
		<exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>

		<!-- Short array syntax [] is a project exception. WordPress uses array(). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Align "=" in a block. Raise the padding cap so long names still line up. -->
	<rule ref="Generic.Formatting.MultipleStatementAlignment">
		<properties>
			<property name="maxPadding" value="80"/>
			<property name="error" value="true"/>
		</properties>
	</rule>

	<!-- Align "=>" even when the key is long. -->
	<rule ref="WordPress.Arrays.MultipleStatementAlignment">
		<properties>
			<property name="maxColumn" value="120"/>
		</properties>
	</rule>

	<!--
		Right margin. A call that would pass this must be multiline.
		WPCS then requires one argument per line (PEAR allowMultipleArguments=false).
		absoluteLineLimit 0 keeps a long aligned comment a warning, not a hard fail.
	-->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="120"/>
			<property name="absoluteLineLimit" value="0"/>
		</properties>
	</rule>

	<rule ref="SlevomatCodingStandard.Functions.RequireMultiLineCall">
		<properties>
			<property name="minLineLength" value="120"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="nominal-ai-provider-for-opencode"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="nominal_ai_po"/>
				<element value="Nominal_AIPO"/>
				<element value="NOMINAL_AIPO"/>
				<element value="Nominal\AIProviderOpenCode"/>
			</property>
		</properties>
	</rule>
</ruleset>
