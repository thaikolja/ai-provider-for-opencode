<?xml version="1.0"?>
<ruleset name="Nominal AI Provider for OpenCode"
	xmlns="https://phpmd.org/xml/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://phpmd.org/xml/ruleset/1.0.0 https://phpmd.org/xml/ruleset_xml_schema_1.0.0.xsd">
	<description>
		PHPMD rules that can sit next to the WordPress coding standard.
		CamelCase rules are off: WordPress methods and variables are snake_case,
		while methods that override the PHP AI Client stay camelCase.
	</description>

	<rule ref="rulesets/cleancode.xml">
		<exclude name="StaticAccess"/>
		<exclude name="ElseExpression"/>
		<exclude name="BooleanArgumentFlag"/>
	</rule>

	<rule ref="rulesets/codesize.xml"/>

	<rule ref="rulesets/controversial.xml">
		<exclude name="CamelCaseClassName"/>
		<exclude name="CamelCasePropertyName"/>
		<exclude name="CamelCaseMethodName"/>
		<exclude name="CamelCaseParameterName"/>
		<exclude name="CamelCaseVariableName"/>
	</rule>

	<rule ref="rulesets/design.xml"/>

	<rule ref="rulesets/naming.xml">
		<!-- usort callbacks and model ids use short names on purpose. -->
		<exclude name="ShortVariable"/>
		<exclude name="LongVariable"/>
		<!-- Re-added below with a higher limit. -->
		<exclude name="LongClassName"/>
	</rule>
	<!-- Nominal_AIPO_ class names are longer than PHPMD's default of 40. -->
	<rule ref="rulesets/naming.xml/LongClassName">
		<properties>
			<property name="maximum" value="60"/>
		</properties>
	</rule>

	<rule ref="rulesets/unusedcode.xml"/>
</ruleset>
