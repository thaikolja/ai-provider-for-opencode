{
  "name":              "thaikolja/nominal-ai-provider-for-opencode",
  "description":       "Nominal AI Provider for OpenCode for the PHP AI Client SDK. Works as both a Composer package and WordPress plugin.",
  "license":           "GPL-2.0-or-later",
  "keywords":          [
    "ai",
    "opencode",
    "wordpress",
    "llm",
    "connector"
  ],
  "authors":           [
    {
      "name":     "Kolja Nolte",
      "homepage": "https://www.kolja-nolte.com",
      "email":    "kolja.nolte@gmail.com"
    }
  ],
  "homepage":          "https://github.com/thaikolja/nominal-ai-provider-for-opencode",
  "support":           {
    "issues": "https://github.com/thaikolja/nominal-ai-provider-for-opencode/issues",
    "source": "https://github.com/thaikolja/nominal-ai-provider-for-opencode"
  },
  "require":           {
    "php": "7.4"
  },
  "require-dev":       {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp":           "^2.1",
    "phpmd/phpmd":                                    "^2.15",
    "phpstan/phpstan":                                "~2.1",
    "slevomat/coding-standard":                       "8.22.1",
    "squizlabs/php_codesniffer":                      ">=3.13.6 <4.0.0",
    "wordpress/php-ai-client":                        "1.3.1",
    "wp-coding-standards/wpcs":                       "^3.0"
  },
  "suggest":           {
    "wordpress/php-ai-client": "Required. The core PHP AI Client SDK that this provider extends."
  },
  "minimum-stability": "dev",
  "prefer-stable":     true,
  "autoload":          {
    "psr-4": {
      "Nominal\\AIProviderOpenCode\\": "src/"
    }
  },
  "config":            {
    "allow-plugins":       {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery":                             true
    },
    "optimize-autoloader": true,
    "platform":            {
      "php": "7.4"
    },
    "sort-packages":       true
  },
  "scripts":           {
    "lint":    [
      "@phpcs",
      "@phpmd",
      "@phpstan"
    ],
    "phpcbf":  "phpcbf",
    "phpcs":   "phpcs",
    "phpmd":   "@php -d error_reporting='E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED' vendor/bin/phpmd src,nominal-ai-provider-for-opencode.php ansi phpmd.xml.dist",
    "phpstan": "phpstan analyze --memory-limit=256M"
  }
}
